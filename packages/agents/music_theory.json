  "permissions": [],
  "limits": {
    "it": [
      "Solo 4/4 e un accordo per battuta nella generazione",
      "Melodie basate su regole, senza sviluppo di motivi",
      "Il riconoscimento della tonalità è una stima (profili di Krumhansl)"
    ],
    "en": [
      "4/4 only and one chord per bar when generating",
      "Rule-based melodies, no motif development",
      "Key finding is an estimate (Krumhansl profiles)"
    ]
  },
  "input_formats": [
    "application/json"
  ],
  "output_formats": [
    "application/json",
    "audio/midi"
  ],
