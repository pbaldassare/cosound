    {
      "name": "detect_key",
      "status": "available",
      "risk": "read",
      "requires_approval": false,
      "summary": {
        "it": "Tonalità più probabile da note o pesi delle classi di altezza",
        "en": "Most likely key from notes or pitch-class weights"
      },
      "input": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "maxItems": 20000,
            "items": {
              "type": "object",
              "properties": {
                "pitch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "dur": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "pitch"
              ]
            }
          },
          "weights": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "items": {
              "type": "number"
            }
          }
        }
      },
      "output": "best, candidates[] with correlation",
      "tools": [
        "music.key_detection"
      ],
      "permissions": [],
      "basis": "estimated"
    },
