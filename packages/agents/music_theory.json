{
  "contract_version": "1",
  "id": "music_theory",
  "name": "Music Theory",
  "version": "1.0.0",
  "role": {
    "it": "Teoria musicale e composizione coerente",
    "en": "Music theory and coherent composition"
  },
  "competencies": {
    "it": [
      "Note, diesis, bemolli, toni e semitoni",
      "Intervalli e scale (maggiori, minori, modali, pentatoniche, blues)",
      "Tonalità, relative e parallele, armature",
      "Accordi, rivolti e progressioni in numeri romani",
      "Melodie, linee di basso e arpeggi",
      "Tensione, risoluzione e cadenze",
      "Coerenza musicale tra le parti",
      "Riconoscimento della tonalità da un insieme di note"
    ],
    "en": [
      "Notes, sharps, flats, tones and semitones",
      "Intervals and scales (major, minor, modal, pentatonic, blues)",
      "Keys, relative and parallel keys, key signatures",
      "Chords, inversions and roman-numeral progressions",
      "Melodies, basslines and arpeggios",
      "Tension, resolution and cadences",
      "Musical coherence between parts",
      "Key finding from a set of notes"
    ]
  },
  "operations": [
    {
      "name": "key_info",
      "status": "available",
      "risk": "read",
      "requires_approval": false,
      "summary": {
        "it": "Scala, armatura, relative e accordi diatonici",
        "en": "Scale, key signature, relative keys and diatonic chords"
      },
      "input": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "tonic": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "major",
              "natural_minor",
              "minor",
              "harmonic_minor",
              "melodic_minor",
              "dorian",
              "phrygian",
              "lydian",
              "mixolydian",
              "locrian",
              "major_pentatonic",
              "minor_pentatonic",
              "blues"
            ]
          }
        }
      },
      "output": "scale, signature, triads[], sevenths[]",
      "tools": [
        "music.theory"
      ],
      "permissions": [],
      "basis": "rule_based"
    },
    {
      "name": "progression",
