{
  "contract_version": "1",
  "id": "mixing_engineer",
  "name": "Mixing Engineer",
  "version": "1.0.0",
  "role": {
    "it": "Diagnosi del mix da misure e proposte di intervento",
    "en": "Mix diagnosis from measurements and proposed moves"
  },
  "competencies": {
    "it": [
      "Bilanciamento dei livelli e gain staging",
      "Equalizzazione, compressione, saturazione, riverbero e delay (proposte)",
      "Immagine stereo e basse in mono",
      "Gestione delle frequenze e sovrapposizioni (indicative)",
      "Analisi della dinamica",
      "Distinzione tra interventi suggeriti ed eseguiti"
    ],
    "en": [
      "Level balance and gain staging",
      "EQ, compression, saturation, reverb and delay (proposals)",
      "Stereo image and mono low end",
      "Frequency management and overlaps (indicative)",
      "Dynamics analysis",
      "Clear split between suggested and executed moves"
    ]
  },
  "operations": [
    {
      "name": "analyze_mix",
      "status": "available",
      "risk": "read",
      "requires_approval": false,
      "summary": {
        "it": "Misure per traccia e proposte di mix (mai eseguite)",
        "en": "Per-track measurements and mix proposals (never executed)"
      },
      "input": {
        "type": "object",
        "properties": {
          "tracks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ]
            }
          },
          "genre": {
            "type": "string"
          }
        },
        "required": [
          "tracks"
        ]
      },
      "output": "tracks[] with measurements, suggestions[] (executed: false)",
      "tools": [
        "audio.wav_meter"
      ],
      "permissions": [
        "files.authorized_read"
      ],
      "basis": "measured"
    },
    {
      "name": "apply_moves",
      "status": "planned",
      "risk": "medium",
      "requires_approval": true,
      "summary": {
        "it": "Applica gli interventi nella DAW",
        "en": "Apply the moves in the DAW"
      },
      "input": {
        "type": "object",
        "properties": {
          "moves": {
            "type": "array"
          }
        },
        "required": [
          "moves"
        ]
      },
      "output": "applied moves",
      "tools": [
        "daw.connectors"
      ],
      "permissions": [
        "daw.control"
      ],
      "requires": "DAW connector (milestone M4)"
    }
  ],
  "tools": [
    "audio.wav_meter",
    "daw.connectors"
  ],
  "permissions": [
    "daw.control",
    "files.authorized_read"
  ],
  "limits": {
    "it": [
      "Solo proposte: nessun intervento viene eseguito",
      "Le misure richiedono file WAV delle tracce",
      "Bande di frequenza approssimative (filtri del 2° ordine), nessuna analisi spettrale fine"
    ],
    "en": [
      "Proposals only: no move is executed",
      "Measurements need WAV files of the tracks",
      "Coarse frequency bands (2nd-order filters), no fine spectral analysis"
    ]
  },
  "input_formats": [
    "application/json",
    "audio/wav"
  ],
  "output_formats": [
    "application/json"
  ],
  "collaborates_with": [
    "audio_analysis",
    "mastering_engineer",
    "daw_controller"
  ]
}