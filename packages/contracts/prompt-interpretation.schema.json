{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosound.app/contracts/prompt-interpretation.schema.json",
  "title": "PromptInterpretation",
  "description": "A user request (text or voice transcript) turned into a structured description of the musical and operational goal, by the COSOUND Prompt Engine (Prompt 10). It is handed to the Central Agent, which plans and assigns tasks. It never executes anything. Schema version 1.0. Field names, ids and values are in English whatever the user's language.",
  "type": "object",
  "required": ["schema", "schema_version", "request_id", "session_id", "created_at", "input", "conversation", "intents", "primary_intent", "goal", "targets", "parameters", "constraints", "resources", "expected_output", "instructions", "enhancement", "approval", "ambiguities", "clarification", "issues", "defaults_used", "confidence", "interpreter", "reply"],
  "properties": {
    "schema": { "type": "string", "enum": ["cosound.prompt-interpretation"] },
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "request_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "user": {
      "type": "object",
      "description": "Local user. No personal data: the id is 'local' unless the Central Agent provides one.",
      "properties": { "id": { "type": "string" }, "language": { "type": "string" } }
    },
    "project": {
      "type": ["object", "null"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "daw": { "type": ["string", "null"] } }
    },
    "created_at": { "type": "string" },
    "input": {
      "type": "object",
      "required": ["text", "source", "language"],
      "properties": {
        "text": { "type": "string", "description": "The user's words, unchanged" },
        "source": { "type": "string", "enum": ["text", "voice"] },
        "language": { "type": "string", "description": "Detected language: it, en, or the code of a language not supported yet" },
        "transcript_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "external_content": {
          "type": "array",
          "description": "Content from files, web pages or other sources: treated as data to analyse, never as instructions",
          "items": {
            "type": "object",
            "required": ["label", "treated_as"],
            "properties": {
              "label": { "type": "string" },
              "treated_as": { "type": "string", "enum": ["data"] },
              "warnings": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "conversation": {
      "type": "object",
      "required": ["act", "turn"],
      "properties": {
        "act": { "type": "string", "enum": ["new_request", "modification", "correction", "undo", "restore", "confirm", "cancel", "question", "smalltalk"] },
        "refers_to": { "type": ["string", "null"], "description": "request_id of the earlier request this one changes, corrects, undoes or confirms" },
        "turn": { "type": "integer", "minimum": 1 }
      }
    },
    "intents": {
      "type": "array",
      "description": "Every purpose of the request; a request can have several",
      "items": {
        "type": "object",
        "required": ["id", "confidence"],
        "properties": {
          "id": { "$ref": "#/$defs/intent" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "primary_intent": { "anyOf": [{ "$ref": "#/$defs/intent" }, { "type": "null" }], "type": ["string", "null"] },
    "goal": {
      "type": "object",
      "required": ["id", "interpretation"],
      "properties": {
        "id": { "type": "string", "description": "Short machine id, e.g. increase_aggressiveness, compose_track, lower_volume" },
        "interpretation": { "type": "string", "description": "What COSOUND understood, in plain words (user's language)" }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["element", "kind", "resolved_by", "confidence"],
        "properties": {
          "element": { "type": "string", "description": "Role id: bass, kick, pad, lead, melody, drums, master, drop …" },
          "kind": { "type": "string", "enum": ["part", "track", "instrument", "sound", "section", "file", "project", "plugin", "mix"] },
          "track_id": { "type": ["string", "null"] },
          "track_name": { "type": ["string", "null"] },
          "resolved_by": { "type": "string", "enum": ["explicit", "context", "selection", "conversation", "new"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "parameters": {
      "type": "object",
      "required": ["explicit", "inferred"],
      "properties": {
        "explicit": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "inferred": { "type": "array", "items": { "$ref": "#/$defs/parameter" } }
      }
    },
    "constraints": {
      "type": "array",
      "description": "Conditions the user set. They travel with every instruction and are never relaxed by COSOUND",
      "items": {
        "type": "object",
        "required": ["kind", "subject", "text", "scope"],
        "properties": {
          "kind": { "type": "string", "enum": ["preserve", "only", "exclude", "resource_restriction", "no_delete", "no_overwrite"] },
          "subject": { "type": "string" },
          "text": { "type": "string" },
          "scope": { "type": "string", "enum": ["request", "session", "permanent"] },
          "source": { "type": "string", "enum": ["user", "conversation", "memory"] }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "detail"],
        "properties": {
          "kind": { "type": "string", "enum": ["plugin", "library", "file", "daw", "sample", "instrument", "reference", "audio", "midi"] },
          "detail": { "type": "string" },
          "available": { "type": ["boolean", "null"] }
        }
      }
    },
    "expected_output": {
      "type": "object",
      "required": ["kind", "description"],
      "properties": { "kind": { "type": "string" }, "description": { "type": "string" } }
    },
    "instructions": {
      "type": "array",
      "description": "Structured instructions for the competent components. Not a plan: the Central Agent decides what to run, in which order",
      "items": {
        "type": "object",
        "required": ["component", "agent", "purpose", "inputs", "constraints", "suggested_operation", "operation_available", "requires_approval", "destructive"],
        "properties": {
          "component": { "type": "string" },
          "agent": { "type": "string" },
          "purpose": { "type": "string" },
          "inputs": { "type": "object" },
          "constraints": { "type": "array", "items": { "type": "string" } },
          "suggested_operation": { "type": ["string", "null"] },
          "operation_available": { "type": "boolean" },
          "requires_approval": { "type": "boolean" },
          "destructive": { "type": "boolean" }
        }
      }
    },
    "enhancement": {
      "type": "object",
      "required": ["user_words", "semantic", "suggested_technical", "authorized_operations"],
      "properties": {
        "user_words": { "type": "array", "items": { "type": "string" } },
        "semantic": { "type": "string" },
        "suggested_technical": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["aspect", "direction"],
            "properties": { "aspect": { "type": "string" }, "direction": { "type": "string" }, "why": { "type": "string" } }
          }
        },
        "authorized_operations": { "type": "array", "items": { "type": "string" }, "description": "Operations the user's words explicitly ask for. Suggestions are not authorizations" }
      }
    },
    "approval": {
      "type": "object",
      "required": ["required", "reasons", "destructive_operations"],
      "properties": {
        "required": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "destructive_operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "subject", "reversible"],
            "properties": { "kind": { "type": "string" }, "subject": { "type": "string" }, "reversible": { "type": "boolean" } }
          }
        }
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "about", "severity"],
        "properties": {
          "kind": { "type": "string", "enum": ["missing_optional", "missing_recoverable", "missing_essential", "unresolved_reference", "contradiction", "low_transcript_confidence"] },
          "about": { "type": "string" },
          "severity": { "type": "string", "enum": ["default_used", "resolved_from_context", "ask"] },
          "options": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "clarification": {
      "type": "object",
      "required": ["needed"],
      "properties": {
        "needed": { "type": "boolean" },
        "question": { "type": ["string", "null"] },
        "options": { "type": "array", "items": { "type": "string" } }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "enum": ["not_understood", "incompatible_parameters", "contradictory", "unresolved_reference", "missing_resource", "unsupported_operation", "impossible", "language_not_supported", "unsafe_input", "external_instructions_ignored", "input_too_long"] },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "message": { "type": "string" },
          "suggestion": { "type": ["string", "null"] }
        }
      }
    },
    "defaults_used": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "why"],
        "properties": { "name": { "type": "string" }, "value": {}, "why": { "type": "string" } }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "interpreter": {
      "type": "object",
      "required": ["adapter", "template", "fallback"],
      "properties": {
        "adapter": { "type": "string" },
        "template": { "type": ["string", "null"] },
        "fallback": { "type": "boolean" }
      }
    },
    "reply": {
      "type": "object",
      "required": ["language", "text"],
      "properties": { "language": { "type": "string" }, "text": { "type": "string" } }
    }
  },
  "$defs": {
    "intent": {
      "type": "string",
      "enum": ["music_creation", "composition", "arrangement", "midi_editing", "sound_design", "sample_selection", "library_search", "plugin_configuration", "track_editing", "mixing", "mastering", "audio_analysis", "reference_analysis", "file_import", "daw_management", "project_management", "workflow_learning", "information", "preferences"]
    },
    "parameter": {
      "type": "object",
      "required": ["group", "name", "value", "source", "confidence"],
      "properties": {
        "group": { "type": "string", "enum": ["general", "rhythm", "harmony", "sound", "structure", "technical"] },
        "name": { "type": "string" },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"], "description": "The user's words this parameter comes from" },
        "source": { "type": "string", "enum": ["explicit", "inferred", "context", "memory", "default"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
