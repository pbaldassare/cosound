{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosound.app/contracts/agent-manifest.schema.json",
  "title": "AgentManifest",
  "description": "Declaration of a specialized agent (packages/agents/<id>.json). Contract v1.",
  "type": "object",
  "required": [
    "contract_version",
    "id",
    "name",
    "version",
    "role",
    "competencies",
    "operations",
    "tools",
    "permissions",
    "limits",
    "input_formats",
    "output_formats"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "role": {
      "type": "object",
      "required": [
        "it",
        "en"
      ],
      "properties": {
        "it": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "competencies": {
      "type": "object",
      "required": [
        "it",
        "en"
      ],
      "properties": {
        "it": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "risk",
          "requires_approval",
          "summary",
          "input",
          "output"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "planned"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "read",
              "low",
              "medium",
              "high"
            ]
          },
          "requires_approval": {
            "type": "boolean"
          },
          "summary": {
            "type": "object",
            "required": [
              "it",
              "en"
            ],
            "properties": {
              "it": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          },
          "input": {
            "type": "object"
          },
          "output": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "basis": {
            "type": "string",
            "enum": [
              "measured",
              "rule_based",
              "convention",
              "estimated",
              "web",
              "file_name",
              "mixed",
              "none"
            ]
          },
          "requires": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "it",
        "en"
      ],
      "properties": {
        "it": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "input_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collaborates_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}