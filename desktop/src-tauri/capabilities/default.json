{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: file/folder pickers, reveal files, open the local data folder and https links. Everything else goes through COSOUND commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$APPDATA" }] },
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }] }
  ]
}
