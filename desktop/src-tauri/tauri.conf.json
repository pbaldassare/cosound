{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COSOUND",
  "version": "0.1.0",
  "identifier": "com.cosound.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "COSOUND", "width": 1360, "height": 860, "minWidth": 980, "minHeight": 640, "backgroundColor": "#07070b" }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/takes/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Music",
    "macOS": { "entitlements": "./Entitlements.plist", "minimumSystemVersion": "12.0" }
  }
}
